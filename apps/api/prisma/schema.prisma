generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  linkedinConnection LinkedInConnection?
  settings           Settings?

  @@map("users")
}

model LinkedInConnection {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  personUrn    String   @map("person_urn")
  connectedAt  DateTime @default(now()) @map("connected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("linkedin_connections")
}

model VoiceSample {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  body      String
  sourceUrl String?  @map("source_url")
  source    String   @default("manual") // manual | linkedin_export | published_by_app | seed
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("voice_samples")
}

model NewsSource {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  rssUrl    String   @map("rss_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("news_sources")
}

model Run {
  id              String    @id @default(uuid()) @db.Uuid
  triggeredBy     String    @map("triggered_by") // cron | manual
  status          String
  collectedAt     DateTime? @map("collected_at")
  storyCount      Int?      @map("story_count")
  winnerJson      Json?     @map("winner_json")
  topStoriesJson  Json?     @map("top_stories_json")
  errorMessage    String?   @map("error_message")
  publishedAt     DateTime? @map("published_at")
  linkedinPostUrn String?   @map("linkedin_post_urn")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  drafts Draft[]
  logs   PipelineLog[]

  @@index([status])
  @@index([createdAt])
  @@map("runs")
}

model Draft {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  version         Int      @default(1)
  chosenStyle     String?  @map("chosen_style")
  hook            String?
  postText        String?  @map("post_text")
  tweetText       String?  @map("tweet_text")
  imagePrompt     String?  @map("image_prompt")
  imageUrl        String?  @map("image_url")
  hashtags        String[] @default([])
  sourceTitle     String?  @map("source_title")
  sourceLink      String?  @map("source_link")
  threeDraftsJson Json?    @map("three_drafts_json")
  status          String   @default("pending")
  feedback        String?
  createdAt       DateTime @default(now()) @map("created_at")

  run  Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  meta ContentDraftMeta?

  @@unique([runId, version])
  @@index([runId, status])
  @@map("drafts")
}

model SourceEvent {
  id               String   @id @default(uuid()) @db.Uuid
  source           String   @default("rss") // rss | hn | github | manual
  project          String?
  eventType        String   @default("story") @map("event_type")
  title            String
  description      String   @default("")
  link             String?
  externalId       String?  @map("external_id")
  payloadJson      Json?    @map("payload_json")
  problem          String?
  decision         String?
  solution         String?
  impact           String?
  technicalContext String?  @map("technical_context")
  occurredAt       DateTime? @map("occurred_at")
  createdAt        DateTime @default(now()) @map("created_at")

  opportunities ContentOpportunity[]

  @@unique([source, externalId])
  @@index([createdAt])
  @@index([source])
  @@map("source_events")
}

model ContentOpportunity {
  id              String   @id @default(uuid()) @db.Uuid
  sourceEventId   String?  @map("source_event_id") @db.Uuid
  runId           String?  @map("run_id") @db.Uuid
  title           String
  link            String?
  pillar          String   @default("engineering")
  format          String?  // engineering_story | technical_breakdown | ...
  contentScore    Float    @default(0) @map("content_score")
  scoresJson      Json?    @map("scores_json")
  anglesJson      Json?    @map("angles_json")
  hooksJson       Json?    @map("hooks_json")
  selectedAngle   String?  @map("selected_angle")
  selectedHook    String?  @map("selected_hook")
  status          String   @default("scored") // scored | selected | rejected | used
  rejectReasons   String[] @default([]) @map("reject_reasons")
  createdAt       DateTime @default(now()) @map("created_at")

  sourceEvent SourceEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([pillar])
  @@index([contentScore])
  @@map("content_opportunities")
}

model ContentDraftMeta {
  id                 String   @id @default(uuid()) @db.Uuid
  draftId            String   @unique @map("draft_id") @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  pillar             String?
  format             String?
  contentScore       Float?   @map("content_score")
  qualityScore       Float?   @map("quality_score")
  authenticityScore  Float?   @map("authenticity_score")
  aiGenericnessScore Float?   @map("ai_genericness_score")
  repetitionScore    Float?   @map("repetition_score")
  diversityScore     Float?   @map("diversity_score")
  scoresJson         Json?    @map("scores_json")
  decision           String?  // approved | rejected | regenerated
  decisionReasons    String[] @default([]) @map("decision_reasons")
  decisionJson       Json?    @map("decision_json")
  selectedAngle      String?  @map("selected_angle")
  selectedHook       String?  @map("selected_hook")
  promptVersions     Json?    @map("prompt_versions")
  regenerationCount  Int      @default(0) @map("regeneration_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([decision])
  @@index([pillar])
  @@map("content_draft_meta")
}

model WritingProfile {
  id        String   @id @default(uuid()) @db.Uuid
  version   Int      @default(1)
  profileJson Json   @map("profile_json")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isActive])
  @@map("writing_profiles")
}

model PublishedPostPerformance {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @unique @map("run_id") @db.Uuid
  draftId         String?  @map("draft_id") @db.Uuid
  linkedinPostUrn String?  @map("linkedin_post_urn")
  pillar          String?
  format          String?
  hook            String?
  contentScore    Float?   @map("content_score")
  qualityScore    Float?   @map("quality_score")
  impressions     Int      @default(0)
  reactions       Int      @default(0)
  comments        Int      @default(0)
  reposts         Int      @default(0)
  clicks          Int      @default(0)
  profileViews    Int      @default(0) @map("profile_views")
  followersGained Int      @default(0) @map("followers_gained")
  publishedAt     DateTime? @map("published_at")
  metricsJson     Json?    @map("metrics_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([pillar])
  @@index([publishedAt])
  @@map("published_post_performance")
}

model PipelineLog {
  id           String   @id @default(uuid()) @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  step         String
  inputExcerpt String?  @map("input_excerpt")
  outputJson   Json?    @map("output_json")
  latencyMs    Int?     @map("latency_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("pipeline_logs")
}

model Settings {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @unique @map("user_id") @db.Uuid
  timezone         String  @default("Asia/Kolkata")
  cronEnabled      Boolean @default(true) @map("cron_enabled")
  telegramChatId   String? @map("telegram_chat_id")
  telegramEnabled  Boolean @default(false) @map("telegram_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  sid       String   @unique
  data      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("sessions")
}
