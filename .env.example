# LinkedIn Daily Poster — environment (personal use)
# Copy to .env at repo root (never commit secrets).

# --- Groq (chat agents) — https://console.groq.com ---
# Create a free API key → paste below
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_RESEARCH_MODEL=llama-3.3-70b-versatile
LLM_RANK_MODEL=openai/gpt-oss-20b
LLM_CONTENT_MODEL=llama-3.3-70b-versatile
LLM_VOICE_MODEL=llama-3.3-70b-versatile
LLM_FALLBACKS=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant

# --- Pixazo (images) ---
PIXAZO_API_KEY=
PIXAZO_BASE_URL=https://gateway.pixazo.ai
PIXAZO_IMAGE_MODEL=flux-schnell
PIXAZO_IMAGE_ENDPOINT=/flux-1-schnell/v1/getData
PIXAZO_IMAGE_WIDTH=1024
PIXAZO_IMAGE_HEIGHT=1024
PIXAZO_NUM_STEPS=4
PIXAZO_FALLBACK_MODEL=sdxl
PIXAZO_FALLBACK_ENDPOINT=/getImage/v1/getSDXLImage

# --- Database ---
# Local (docker compose --profile local-db up -d):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_bot
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/linkedin_bot
# Neon Free (prod) — paste both from console.neon.tech → Connect → Prisma:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=dev-encryption-key-change-me-32b
SESSION_SECRET=dev-session-secret-change-me
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_PORT=3001
TZ=Asia/Kolkata
CRON_ENABLED=true

# Seed login (used by pnpm db:seed)
SEED_EMAIL=you@example.com
SEED_PASSWORD=changeme

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/linkedin/oauth/callback
LINKEDIN_API_VERSION=202607

# --- Telegram (draft-ready ping) ---
# 1. Telegram → search @BotFather (blue check) → /newbot
# 2. Name: LinkedIn Daily Poster · username must end in bot
# 3. Copy the token (looks like 123456:AA...)
# 4. Open your new bot → Start → send "hi"
# 5. Browser: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Copy chat.id (a number, e.g. 512345678)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Media / Backblaze B2 ---
# Dev without B2: MEDIA_DRIVER=local
# Prod:
# 1. https://secure.backblaze.com/user_signin.htm → enable B2 Cloud Storage
# 2. Buckets → Create a Bucket
#      Name: globally unique, e.g. ldp-yourname
#      Files in Bucket are: Public  (dashboard image preview)
# 3. Copy Endpoint from the bucket row, e.g. s3.us-west-004.backblazeb2.com
#    Region = the middle part (us-west-004)
# 4. Application Keys → Add a New Application Key
#      Name: linkedin-daily-poster
#      Allow access to Bucket(s): that bucket
#      Allow List All Bucket Names: ON  (needed for S3 HeadBucket)
#      Type: Read and Write
#    Copy keyID and applicationKey (secret shown once)
# 5. Set MEDIA_DRIVER=b2
MEDIA_DRIVER=local
UPLOADS_DIR=./uploads
B2_BUCKET=
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
# Public URL prefix. After bucket create, use:
# https://<bucket>.s3.<region>.backblazeb2.com
B2_PUBLIC_BASE_URL=
